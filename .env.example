# Copy to .env.local for development. Nothing here is required for `npm run dev`.
# Most values can instead be set later in Admin → Configuration (a value saved there wins).

# --- Core -------------------------------------------------------------------
# Public origin. Carriers, OAuth redirects and Stripe return links are built from it.
APP_URL=http://localhost:3000
PORT=3000
# Postgres (recommended in production; required on hosts that wipe the disk on redeploy, like Railway).
# The app creates its one table on first start. Without it, data goes to data/db.json.
# Supabase: Project → Connect → "Session pooler" string (port 5432; the direct host is IPv6-only).
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# For verified TLS, download the CA (Database → Settings → SSL Configuration) and point at it:
# DATABASE_CA_CERT=./prod-ca-2021.crt
# DATABASE_URL=postgres://user:password@host:5432/reception
# Where data/db.json lives when DATABASE_URL is not set. Point at a persistent volume.
# DATA_DIR=/data
# 32 random bytes, base64. Seals carrier and connector credentials. Never rotate while secrets are stored.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# CREDENTIAL_ENCRYPTION_KEY=

# --- AI ---------------------------------------------------------------------
# Live phone calls, landing-page live voice, text-to-speech and transcription.
OPENAI_API_KEY=
# REALTIME_MODEL=gpt-realtime
# Browser chat, the widget, the turn-based phone fallback, the agent designer.
XAI_API_KEY=

# --- Admins & sign-in ---------------------------------------------------------
# Addresses that become super-admins once confirmed (Google sign-in or an emailed/logged link).
# While set, "the first account becomes admin" is switched off.
# ADMIN_EMAILS=you@example.com
# "Continue with Google" on the sign-in page. Redirect URI: <APP_URL>/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Mail for the admin confirmation link. Without SMTP the link is printed in the server log ([admin] ...).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# --- Phone ------------------------------------------------------------------
# Plivo webhook verification fallback (each imported number also stores its own credentials).
# PLIVO_AUTH_ID=
# PLIVO_AUTH_TOKEN=
# OpenAI SIP calls: signing secret of the webhook pointed at <APP_URL>/api/voice/realtime.
# OPENAI_WEBHOOK_SECRET=whsec_...
# Development only: accept carrier webhooks without verifying signatures.
# VOICE_SKIP_SIGNATURES=true

# --- Jobs -------------------------------------------------------------------
# Bearer token for POST /api/jobs/run from an external cron (the server also drains every minute).
# JOBS_SECRET=
# On hosts that sleep, QStash calls /api/jobs/run when queued work is due.
# QSTASH_TOKEN=

# --- Billing ----------------------------------------------------------------
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- Connector OAuth (optional; users can paste tokens instead) -------------
# GOOGLE_CONNECTOR_CLIENT_ID=
# GOOGLE_CONNECTOR_CLIENT_SECRET=
# GOOGLE_ENABLE_GMAIL_READ=false
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=common
# SALESFORCE_CLIENT_ID=
# SALESFORCE_CLIENT_SECRET=
# SALESFORCE_LOGIN_URL=https://login.salesforce.com

# --- Showroom ---------------------------------------------------------------
# true = public demo: one-click demo accounts, every write refused. Conversations still cost model spend.
DEMO_MODE=false

# --- Brand & site (easier to set in Admin → Configuration) -------------------
# BRAND_NAME=Reception AI
# SUPPORT_EMAIL=
# SITE_TITLE=
# SITE_DESCRIPTION=
# TERMS_URL=
# PRIVACY_URL=
# COMPANY_NAME=
